# Across AI - Environment Configuration

# Hugging Face / Groq OpenAI-Compatible Inference Router
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_MODELS=qwen/qwen3.8-27b,llama-3.1-8b-instant

# ChromaDB & Embedding Configuration
CHROMA_PERSIST_DIR=./mgi_chroma_db
CHROMA_COLLECTION=mgi_policy_handbook
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True
